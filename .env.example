# Puerto HTTP público del servicio (Kong lo alcanza acá).
PORT=8080

# Puerto HTTP interno, exclusivo de las rutas /internal/* (US-05). Se sirve en
# un *http.Server separado del público y nunca se publica en Kong ni en el
# docker-compose fuera de la red interna: solo vinculo-vial-alert lo alcanza,
# dentro de la red `vinculo-vial`. Debe ser distinto de PORT.
INTERNAL_PORT=8081

# Cadena de conexión a la base de datos PostgreSQL propia del servicio (database-per-service).
DATABASE_URL=postgres://vehicle:vehicle@localhost:5432/vehicle?sslmode=disable

# Plazo máximo, en milisegundos, de cada consulta contra la base de datos propia.
# Agotado, el contexto se cancela y el repositorio reporta indisponibilidad (503)
# en lugar de esperar indefinidamente a una base de datos lenta o bloqueada. Debe
# mantenerse por debajo del timeout servicio-a-servicio con el que Alert llama a
# este servicio (2000ms): de lo contrario Alert abandona la espera antes de que
# Vehicle llegue a responder el 503, violando la regla de anidamiento de timeouts
# de la plataforma (servicio→servicio > deadline de consulta DB).
DB_QUERY_TIMEOUT_MS=1500

# Clave privada HPKE (X25519) del servicio, usada para desencriptar el payload
# del vehículo (patente, chasis) recibido en payload_enc.
# Par nuevo de US-04; la clave pública correspondiente se distribuye a la app cliente.
VEHICLE_HPKE_PRIVATE_KEY=

# Clave simétrica AES-256 (32 bytes, codificados en base64) usada para el cifrado at-rest de la patente.
PAT_AES_KEY=

# Secreto usado para calcular el Blind Index (HMAC-SHA256) de la patente.
PAT_HMAC_SECRET=

# URL interna (red privada, nunca expuesta en Kong) del servicio Identity para
# verificación de propiedad. Identity expone /internal/verify-ownership en un
# servidor HTTP interno separado del público (puerto 8081, no 8080).
IDENTITY_INTERNAL_URL=http://vinculo-vial-identity:8081/internal/verify-ownership

# Timeout explícito, en milisegundos, para la llamada a Identity.
IDENTITY_TIMEOUT_MS=2000

# Circuit breaker de fail-fast hacia Identity. Con IDENTITY_CB_FAILURE_THRESHOLD
# fallas contabilizables (timeout, error de conexión o 5xx/cuerpo inválido; un
# 4xx no cuenta) dentro de IDENTITY_CB_WINDOW_MS, el circuito se abre y las
# llamadas fallan de inmediato sin alcanzar a Identity durante
# IDENTITY_CB_OPEN_DURATION_MS, tras lo cual se admite una única llamada de
# prueba. Todas tienen valores por defecto razonables si se omiten.
IDENTITY_CB_FAILURE_THRESHOLD=5
IDENTITY_CB_WINDOW_MS=30000
IDENTITY_CB_OPEN_DURATION_MS=30000

# Clave pública HPKE (X25519) de Identity, usada por este servicio para cifrar el
# DNI obtenido del DNRPA antes de enviarlo a /internal/verify-ownership.
IDENTITY_HPKE_PUBLIC_KEY=

# Clave pública HPKE (X25519, 32 bytes en base64) de vinculo-vial-ia. Vehicle cifra
# la patente canónica hacia IA con info = alert_id. Debe ser la pareja de
# IA_HPKE_PRIVATE_KEY en vinculo-vial-ia.
IA_HPKE_PUBLIC_KEY=reemplazar

# Clave pública X25519 de vinculo-vial-audit (US-11), en base64 (32 bytes), y el id
# corto de ese par (hasta 32 caracteres, por ejemplo 2026-11). Vehicle sella la
# patente canónica hacia esta clave con info = "vv-audit:pat:" + alert_id y devuelve
# el criptograma como pat_enc_audit junto con AUDIT_KEY_ID. Ambos valores deben ser
# iguales a los de vinculo-vial-identity. Son obligatorios: sin ellos, o con una
# clave que no decodifica a 32 bytes, el servicio no arranca. La clave privada la
# genera audit-keygen (repo de Audit), la custodia el responsable legal fuera de
# línea y no la carga ningún servicio.
AUDIT_PUBLIC_KEY=reemplazar
AUDIT_KEY_ID=reemplazar

# DNI que retorna incondicionalmente el adaptador simulado del registro automotor
# (MockDNRPAAdapter), para pruebas end-to-end sin integración real con el DNRPA.
MOCK_DNRPA_OWNER_DNI=

# Token compartido para autorizar tráfico de servicio a servicio en la red interna.
# Cumple doble función: se envía en el header X-Internal-Service-Token en cada
# llamada saliente a Identity, y este servicio exige ese mismo header con este
# mismo valor en toda petición entrante a sus propias rutas /internal/* (US-05),
# que solo debe alcanzar vinculo-vial-alert.
INTERNAL_SERVICE_TOKEN=

# Si es true, al arrancar se elimina y recrea el esquema public completo antes de
# AutoMigrate, destruyendo todos los datos existentes. Uso exclusivo de despliegues
# efímeros para pruebas end-to-end; nunca debe activarse contra una base con datos
# reales. Por defecto false.
EPHEMERAL_DB=false

# Ventana de entrega de alertas pendientes (US-10), en horas. Cuando Alert resuelve
# una patente sin dueños, Vehicle la reserva en pending_plates por este plazo,
# renovado con cada alerta nueva a esa patente. Si el primer dueño la vincula
# dentro de la ventana, recibe las alertas. Debe ser mayor a cero y coincidir con
# PENDING_DELIVERY_HOURS de vinculo-vial-alert. Por defecto 24.
PENDING_DELIVERY_HOURS=24

# Cada cuántos milisegundos el sweeper borra las patentes pendientes vencidas.
# Por defecto 60000.
SWEEPER_INTERVAL_MS=60000

# URL de conexión al broker RabbitMQ compartido por el ecosistema, alcanzable a
# través de la red externa vinculo-vial. Obligatoria. La topología (exchange,
# colas, retry, DLQ) la declara vinculo-vial-core; este servicio únicamente
# publica. Si el broker está inalcanzable al arrancar, el servicio NO aborta:
# arranca en modo degradado, reconecta en background con backoff y los eventos
# esperan en el outbox. Solo aborta el arranque si RABBITMQ_EXCHANGE no existe
# (eso sí es un error de despliegue).
RABBITMQ_URL=amqp://guest:guest@vinculo-vial-rabbitmq:5672/

# Exchange topic donde se publican los eventos del servicio (hoy,
# vehicle.pending.claimed), con el Event Envelope estándar de la plataforma.
# Vehicle verifica con una declaración pasiva que ya exista, al arrancar y al
# reconectar: nunca lo crea.
RABBITMQ_EXCHANGE=vvi.topic.exchange

# Timeout, en milisegundos, de cada publicación a RabbitMQ, incluida la espera del
# publisher confirm. Sin él, un broker en flow control bloquearía al worker.
RABBITMQ_PUBLISH_TIMEOUT_MS=2000

# Worker de outbox: publica en background los eventos persistidos en la misma
# transacción que el cambio que los origina (transactional outbox). Ninguna
# operación de negocio depende de RabbitMQ: solo este worker. INTERVAL_MS es
# cada cuánto revisa si hay eventos pendientes; BATCH_SIZE (>= 1) acota cuántos
# intenta publicar por ciclo.
OUTBOX_WORKER_INTERVAL_MS=2000
OUTBOX_WORKER_BATCH_SIZE=20

# Cola de trabajo de la que Vehicle consume user.deleted (US-11, baja de cuenta):
# borra los vehículos del usuario dado de baja. Sigue la convención
# <consumidor>.<evento-kebab>.q y debe coincidir con la que declara
# vinculo-vial-core, junto con su .retry y su .dlq. Por defecto vehicle.user-deleted.q.
USER_DELETED_QUEUE=vehicle.user-deleted.q

# Prefetch (basic.qos) de los consumidores: cuántos mensajes sin ack admite el canal
# en vuelo. Entre 1 y 65535. Por defecto 10.
RABBITMQ_PREFETCH=10

# Reintentos de un mensaje con fallo transitorio (cola .retry con TTL, contados por
# x-death) antes de derivarlo a la DLQ. Mayor o igual a 0. Por defecto 5.
MAX_RETRIES=5
