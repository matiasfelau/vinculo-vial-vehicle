# Puerto HTTP expuesto por el servicio.
PORT=8080

# Cadena de conexión a la base de datos PostgreSQL propia del servicio (database-per-service).
DATABASE_URL=postgres://vehicle:vehicle@localhost:5432/vehicle?sslmode=disable

# Clave privada HPKE (X25519) del servicio, usada para desencriptar el payload
# del vehículo (patente, chasis) recibido en payload_enc.
# Par nuevo de US-04; la clave pública correspondiente se distribuye a la app cliente.
VEHICLE_HPKE_PRIVATE_KEY=

# Clave simétrica AES-256 (32 bytes, codificados en base64) usada para el cifrado at-rest de la patente.
PAT_AES_KEY=

# Secreto usado para calcular el Blind Index (HMAC-SHA256) de la patente.
PAT_HMAC_SECRET=

# URL interna (red privada, nunca expuesta en Kong) del servicio Identity para verificación de propiedad.
IDENTITY_INTERNAL_URL=http://vinculo-vial-identity:8080/internal/verify-ownership

# Timeout explícito, en milisegundos, para la llamada a Identity.
IDENTITY_TIMEOUT_MS=2000

# Clave pública HPKE (X25519) de Identity, usada por este servicio para cifrar el
# DNI obtenido del DNRPA antes de enviarlo a /internal/verify-ownership.
IDENTITY_HPKE_PUBLIC_KEY=

# DNI que retorna incondicionalmente el adaptador simulado del registro automotor
# (MockDNRPAAdapter), para pruebas end-to-end sin integración real con el DNRPA.
MOCK_DNRPA_OWNER_DNI=
